# Backend Environment Variables
# Copy this file to .env and fill in the values

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportscore
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=sportscore-access-secret-change-in-production
JWT_REFRESH_SECRET=sportscore-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

PORT=3002

# Public URL where this backend is accessible (used for generating file URLs, logs, etc.)
APP_URL=http://localhost:3002

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

NODE_ENV=development
